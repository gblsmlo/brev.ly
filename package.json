{
  "name": "brev-ly",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "build": "bun run --parallel --workspaces build",
    "db:generate": "bun run --cwd server db:generate",
    "db:migrate": "bun run --cwd server db:migrate",
    "dev": "bun run --parallel --workspaces dev",
    "dev:server": "bun run --cwd server dev",
    "dev:web": "bun run --cwd web dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun run --parallel --workspaces test",
    "typecheck": "bun run --parallel --workspaces typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
